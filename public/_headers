/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'

# theme-boot.js 必须是阻塞脚本，且需要长期缓存
/theme-boot.js
  Cache-Control: public, max-age=3600

# 生成结果与参考图由 /api/* 端点鉴权后返回，禁止 CDN 缓存
/api/*
  Cache-Control: no-store
