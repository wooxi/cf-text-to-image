{
  "name": "cf-text-to-image",
  "version": "4.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build:next": "next build",
    "build:api": "wrangler pages functions build --outdir=dist/functions",
    "build": "npm run build:next && npm run build:api",
    "deploy": "npm run build && npm run cf:prepare && wrangler deploy && npm run db:migrate:remote",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:prepare": "wrangler r2 bucket create txt2img-images || true; wrangler queues create txt2img-task-queue || true"
  },
  "dependencies": {
    "jose": "^5.9.0",
    "lucide-react": "^1.45.0",
    "next": "^14.2.35",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250601.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.0.0"
  }
}
